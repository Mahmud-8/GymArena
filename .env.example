# Optional overrides. docker compose up works without copying this file.
# Passwords are generated into Docker volumes; no credentials belong here.
# Defaults bind the HTTP ports to localhost only.
GYMARENA_BIND_ADDRESS=127.0.0.1
GYMARENA_PYTHON_IMAGE=python:3.12-slim-bookworm
GYMARENA_POSTGRES_IMAGE=postgres:16-bookworm
TRACKING_PORT=8101
MEMBERSHIP_PORT=8102
SESSION_PORT=8103
NOTIFICATION_PORT=8104
MEMBER_PORT=8105
RECOGNITION_PORT=8106
CHALLENGE_PORT=8107
SCORING_PORT=8108
